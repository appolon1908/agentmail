AGENTMAIL_ENV=development
AGENTMAIL_API_KEY=
AGENTMAIL_API_BASE_URL=
AGENTMAIL_WEBHOOK_SECRET=

# Fail-closed outbound effects
AGENTMAIL_LIVE_SEND_ENABLED=false
AGENTMAIL_PRODUCTION_APPROVED=false
# Comma-separated exact addresses or @domain entries, e.g. qa@example.com,@codestra.co
AGENTMAIL_RECIPIENT_ALLOWLIST=
AGENTMAIL_MAX_RECIPIENTS=10

# Klyrow callback. Leave blank to accept/verify AgentMail events without forwarding.
KLYROW_CALLBACK_URL=
KLYROW_CALLBACK_HMAC_SECRET=
KLYROW_CALLBACK_TIMEOUT_SECONDS=10

# Service
CODESRA_AGENTMAIL_HOST=0.0.0.0
CODESRA_AGENTMAIL_PORT=8097
LOG_LEVEL=INFO
